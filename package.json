  "scripts": {
    "prod:desktop": "npm run dev:desktop:renderer && npm run prod:desktop:main && npm run prod:desktop:preload",
    "prod:desktop:electron": "npm run prod:desktop:main && npm run prod:desktop:preload",
    "prod:desktop:main": "webpack --config main.config.js --env output=desktop-client --env isProduction --env nodeEnv=production",
    "prod:desktop:preload": "webpack --config preload.config.js --env output=desktop-client --env isProduction --env nodeEnv=production",
    "prod:desktop:renderer": "webpack --config renderer.config.js --env output=desktop-client --env isProduction --env nodeEnv=production",
    "dev:desktop": "npm run dev:desktop:renderer && npm run dev:desktop:main && npm run dev:desktop:preload",
    "dev:desktop:electron": "npm run dev:desktop:main && npm run dev:desktop:preload",
    "dev:desktop:main": "webpack --config main.config.js --env output=desktop-client --env nodeEnv=development",
    "dev:desktop:preload": "webpack --config preload.config.js --env output=desktop-client --env nodeEnv=development",
    "dev:desktop:renderer": "webpack --config renderer.config.js --env output=desktop-client --env nodeEnv=development",
    "postinstall": "electron-builder install-app-deps",
    "prod:web": "webpack --config web.config.js --env isProduction --env nodeEnv=production",
    "prod:was": "webpack --config server.config.js --env isProduction --env nodeEnv=production",
    "dev:web": "webpack --config web.config.js --env nodeEnv=development",
    "dev:was": "webpack --config server.config.js --env nodeEnv=development",
    "dev:plugin": "webpack --config plugin.config.js --env nodeEnv=development",
    "prod:plugin": "webpack --config plugin.config.js --env isProduction --env nodeEnv=production",
    "dev:extension:popup": "webpack --config popup.config.js --env nodeEnv=development",
    "prod:extension:popup": "webpack --config popup.config.js --env isProduction --env nodeEnv=production",
    "dev:extension:content-script": "webpack --config content-script.config.js --env nodeEnv=development",
    "prod:extension:content-script": "webpack --config content-script.config.js --env isProduction --env nodeEnv=production",
    "dev:extension:background": "webpack --config background.config.js --env nodeEnv=development",
    "prod:extension:background": "webpack --config background.config.js --env isProduction --env nodeEnv=production",
    "dev:extension": "npm run dev:extension:content-script && npm run dev:extension:background && npm run dev:extension:popup",
    "prod:extension": "npm run prod:extension:content-script && npm run prod:extension:background && npm run prod:extension:popup",
    "start:desktop": "electron .",
    "start:was": "node ./bundle/server/index.js",
    "serve:desktop:user": "webpack serve --config user.serve.config.js --env nodeEnv=devserver --env output=desktop-client",
    "serve:web": "webpack serve --config web.config.js",
    "serve:test": "webpack serve --config test.config.js --env nodeEnv=devserver --env output=test",
    "serve:content-script": "webpack serve --config content-script-dev-server.config.js --env devserver --env nodeEnv=devserver",
    "package:win32": "electron-builder build --win --ia32",
    "package:win64": "electron-builder build --win --x64",
    "package:mac": "electron-builder build --mac",
    "publish": "electron-builder --mac --win -p always",
    "gcloud-deploy": "gcloud beta builds submit",
    "cpweb": "docker cp bundle/web/. proxy:/etc/nginx/html",
    "rmweb": "docker exec proxy sh -c \"rm -rf /etc/nginx/html\"",
    "docker:run:proxy": "docker run --rm --name proxy -dp 80:80 724a6306a476",
    "docker:cp:nginxconf": "docker cp nginx.dev.conf proxy:/etc/nginx/nginx.conf",
    "docker:build:proxy": "docker build --no-cache -t asia-northeast3-docker.pkg.dev/gatsby-377601/docker-repo/proxy:1.0.0 -f nginx.dev.dockerfile .",
    "prettier:external": "prettier --write src/external/**/*.js"
  }
